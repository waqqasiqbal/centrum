# Required for the server and live model tests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Safe local-development defaults.
AI_ENABLE_DEMO_KEYS=true
AI_DATABASE_PATH=.data/ai-interfaces.db
AI_ARTIFACT_DIR=.data/artifacts
PORT=3000

# Production deployments must provide a secret of at least 32 bytes and explicit
# comma-separated HTTPS origins. Do not reuse these example placeholders.
# AI_CURSOR_SECRET=
# AI_ALLOWED_ORIGINS=https://app.example.com
