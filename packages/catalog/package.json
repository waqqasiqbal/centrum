{
  "name": "@ai-interfaces/catalog",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "files": ["dist"],
  "description": "Tenant-scoped catalog repository and governed product capability for AI Interfaces",
  "repository": {
    "type": "git",
    "url": "https://github.com/waqqasiqbal/centrum.git",
    "directory": "packages/catalog"
  },
  "bugs": { "url": "https://github.com/waqqasiqbal/centrum/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --platform node --external node:sqlite"
  },
  "dependencies": {
    "@ai-interfaces/core": "workspace:*",
    "zod": "^4.0.0"
  }
}
