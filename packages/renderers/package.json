{
  "name": "@ai-interfaces/renderers",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "files": ["dist"],
  "description": "Deterministic JSON and PDF renderers for AI Interfaces",
  "repository": {
    "type": "git",
    "url": "https://github.com/waqqasiqbal/centrum.git",
    "directory": "packages/renderers"
  },
  "bugs": { "url": "https://github.com/waqqasiqbal/centrum/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --platform node"
  },
  "dependencies": {
    "@ai-interfaces/catalog": "workspace:*",
    "@ai-interfaces/core": "workspace:*",
    "pdfkit": "^0.17.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.0"
  }
}
