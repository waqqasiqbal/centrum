{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@ai-interfaces/core": ["packages/core/src/index.ts"],
      "@ai-interfaces/openai": ["packages/openai/src/index.ts"],
      "@ai-interfaces/google": ["packages/google/src/index.ts"],
      "@ai-interfaces/catalog": ["packages/catalog/src/index.ts"],
      "@ai-interfaces/renderers": ["packages/renderers/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "scripts/**/*.ts", "tests/**/*.ts"]
}
